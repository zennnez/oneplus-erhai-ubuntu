    "Description[sa]": "\u0936\u0915\u094d\u0924\u093f\u092a\u094d\u0930\u092c\u0928\u094d\u0927\u0928\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938\u094d \u0928\u093f\u092f\u0928\u094d\u0924\u094d\u0930\u092f\u0928\u094d\u0924\u0941 \u0924\u0925\u093e \u091a \u0938\u094d\u0935\u0938\u094d\u092f \u092c\u0948\u091f\u0930\u0940 \u0907\u0924\u094d\u092f\u0938\u094d\u092f \u0936\u0915\u094d\u0924\u093f\u0938\u094d\u0925\u093f\u0924\u093f\u0902 \u092a\u0936\u094d\u092f\u0928\u094d\u0924\u0941",
