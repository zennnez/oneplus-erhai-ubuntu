    "Description[ko]": "\uc804\uc6d0 \uad00\ub9ac \uc124\uc815\uc744 \uc870\uc815\ud558\uace0 \ubc30\ud130\ub9ac\uc758 \uc804\ub825 \uc0c1\ud0dc \ud45c\uc2dc",
    "Description[lt]": "Valdyti maitinimo valdymo nuostatas ir \u017ei\u016br\u0117ti akumuliatoriaus \u012fkrov\u0105",
